# 로컬 실행 순서: pnpm db:dev → pnpm db:migrate → pnpm dev
# (dev-db.sh가 .env.local을 자동 생성하므로 보통 이 파일을 직접 복사할 필요는 없다)

# 공통
NODE_ENV=
APP_ENV=local

# DB — 로컬(dev-db.sh 자동 생성) 또는 Cloud SQL 커넥터 중 하나
DATABASE_URL=
CLOUD_SQL_CONNECTION_NAME=
DB_IAM_USER=
DB_NAME=erp
DB_POOL_MAX=5
DB_ADMIN_PASSWORD=
DB_ADMIN_URL=

# 인증
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
AUTH_PROVIDER=email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 잠금·속도 제한
LOCKOUT_THRESHOLD=5
LOCKOUT_WINDOW_MINUTES=15
RATE_LIMIT_LOGIN_MAX=10

# Phase 3 헬퍼(정의만)
APP_DATA_KEY_v1=

# 이메일(Phase 7, 정의만)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# GCP 상태 화면 조회
GCP_PROJECT_ID=
CLOUD_SQL_INSTANCE_ID=

# deploy.sh가 주입
APP_GIT_SHA=
APP_DEPLOYED_AT=

# migrate Job 16A 검사
MAX_INSTANCES=

# 상태 화면 배너 임계
STATUS_CONN_BANNER_RATIO=0.8
