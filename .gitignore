# Claude Code personal settings (per machine)
.claude/settings.local.json
.claude/.gsd-staging/
.claude/scheduled_tasks.lock
.claude/*.lock

# GSD harness-managed agent worktrees and run-scoped tool state (ephemeral, never source content)
.claude/worktrees/
.gsd/
.planning/**/.review-fix-recovery-pending.json

# gstack: team mode — global install (~/.claude/skills/gstack), never vendored
.claude/skills/gstack/

# Node
node_modules/

# GSD research web-search cache (tool artifact)
.planning/research/.cache/

# Next.js app
.env
.env.*
!.env.example
.next/
dist/
playwright-report/
test-results/
*.tsbuildinfo
next-env.d.ts

# GitHub Actions WIF credential files (google-github-actions/auth writes these
# into $GITHUB_WORKSPACE — must be ignored or deploy.sh's dirty-tree check and
# docker build context break, plan review CEO OV-2)
gha-creds-*.json

# deploy.yml pipes deploy.sh's output into this via `tee` from $GITHUB_WORKSPACE —
# same dirty-tree check as above trips on it if untracked
deploy.log

# GSD runtime lock: a session-scoped advisory claim over STATE.md's Current
# Position, holding {phase, session, pid, updated_at} and expiring by TTL
# (.claude/gsd-core/bin/lib/milestone-lock.cjs, #3311). Machine- and
# session-specific runtime state, not source — same class as the entries above.
.planning/milestone.lock
