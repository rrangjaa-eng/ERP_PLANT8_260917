   case "$cmd" in
     git) check_git "${ARGS[@]}" ;;
     gh) check_gh "${ARGS[@]}" ;;
+    codex)
+      case "${ARGS[0]:-} ${ARGS[1]:-}" in
+        "--version "*|"-V "*|"--help "*|"-h "*|"login status") ;;
+        *) codex_allowed || block "$CODEX_MSG" ;;
+      esac ;;
+    npx|bunx|pnpm|npm)
+      # 실행(npx, bunx, pnpm/npm dlx·exec·x)만 막는다 — 설치는 Codex 호출이 아니다.
+      if [ "$cmd" = npx ] || [ "$cmd" = bunx ] || [[ "${ARGS[0]:-}" =~ ^(dlx|exec|x)$ ]]; then
+        for a in "${ARGS[@]}"; do
+          case "$a" in @openai/codex|@openai/codex@*) codex_allowed || block "$CODEX_MSG" ;; esac
+        done
+      fi ;;&
     npm)
       local sub=""
       for a in "${ARGS[@]}"; do case "$a" in -*) ;; *) sub="$a"; break ;; esac; done
