{
  "name": "plant8-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:cli": "node scripts/build-cli.mjs",
    "lint": "eslint . && stylelint \"ui/**/*.module.css\" \"app/globals.css\" \"app/**/*.module.css\"",
    "lint:sql": "squawk --config .squawk.toml db/migrations/*.sql",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:dev": "bash scripts/dev-db.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-runner.ts",
    "account:create": "node --env-file-if-exists=.env.local --import tsx scripts/account-cli.ts create",
    "account:reset": "node --env-file-if-exists=.env.local --import tsx scripts/account-cli.ts reset",
    "account:unlock": "node --env-file-if-exists=.env.local --import tsx scripts/account-cli.ts unlock",
    "deploy": "bash scripts/deploy.sh",
    "rollback": "bash scripts/rollback.sh"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@google-cloud/cloud-sql-connector": "1.12.0",
    "@googleapis/sqladmin": "40.0.0",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "google-auth-library": "11.1.0",
    "next": "16.3.5",
    "next-safe-action": "8.7.3",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/rule-tester": "8.70.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-boundaries": "7.2.0",
    "squawk-cli": "2.65.0",
    "stylelint": "17.15.0",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "squawk-cli"
    ]
  }
}
