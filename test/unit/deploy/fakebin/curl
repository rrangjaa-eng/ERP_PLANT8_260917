#!/usr/bin/env bash
# 가짜 curl — deploy.sh의 스모크 검사 4종(health GET, login GET, sign-in POST, notify-tick POST)을 흉내 낸다.
set -u

STATE="${DEPLOY_FAKE_STATE:-}"
LOG="${DEPLOY_FAKE_LOG:-}"
ARGS="$*"

state_file() { [ -n "$STATE" ] && [ -f "$STATE/$1" ]; }
state_val()  { [ -n "$STATE" ] && [ -f "$STATE/$1" ] && cat "$STATE/$1"; }

if [ -n "$LOG" ]; then
  printf '%s\n' "$ARGS" >>"$LOG"
fi

case "$ARGS" in
  *"/api/health"*)
    if state_file health && [ "$(state_val health)" = "503" ]; then
      echo "fake curl: health 503" >&2
      exit 22
    fi
    echo '{"ok":true}'
    exit 0
    ;;
  *"sign-in/email"*)
    code="401"
    if state_file signin; then
      code="$(state_val signin)"
    fi
    printf '%s' "$code"
    exit 0
    ;;
  *"/internal/notify-tick"*)
    # 토큰 없는 POST — 앱이 401을 돌려주는 것이 정상(D-4214). 상태 파일 notify-tick으로 바꾼다.
    code="401"
    if state_file notify-tick; then
      code="$(state_val notify-tick)"
    fi
    printf '%s' "$code"
    exit 0
    ;;
  *"/login"*)
    printf '200'
    exit 0
    ;;
  *)
    # 알려지지 않은 경로(예: smoke()의 빠른 진단 프로브 "/") — 200으로
    # 가장한다. 이 파일이 실제로 검사하는 3가지(health·login·sign-in)는
    # 위에서 이미 명시적으로 다룬다.
    printf '200'
    exit 0
    ;;
esac
