#!/usr/bin/env bash
# 가짜 gcloud — deploy.sh/rollback.sh/bootstrap-gcp.sh 단위 테스트용.
# 호출 인자를 $DEPLOY_FAKE_LOG에 한 줄씩 append하고, $DEPLOY_FAKE_STATE 디렉터리의
# 파일로 상태(서비스 존재·이미지 존재·리비전 목록 등)를 흉내 낸다.
set -u

STATE="${DEPLOY_FAKE_STATE:-}"
LOG="${DEPLOY_FAKE_LOG:-}"
ARGS="$*"

state_file() { [ -n "$STATE" ] && [ -f "$STATE/$1" ]; }
# 상태 파일이 없으면 그냥 빈 값으로 성공(exit 0) — "목록이 비어 있음"과 "명령
# 자체가 실패함"을 구분한다(가짜 gcloud가 실패로 취급해야 하는 경우는 각 case
# 분기에서 state_file로 명시적으로 검사한다).
state_val() {
  if [ -n "$STATE" ] && [ -f "$STATE/$1" ]; then
    cat "$STATE/$1"
  fi
}

if [ -n "$LOG" ]; then
  printf '%s\n' "$ARGS" >>"$LOG"
fi

# 임의 하위 명령을 실패시키는 범용 훅(behavior 5b): 상태 파일 fail-gcloud의 내용이
# 이번 호출 인자의 접두어면 실패한다.
if state_file fail-gcloud; then
  needle="$(state_val fail-gcloud)"
  case "$ARGS" in
    "$needle"*)
      echo "fake gcloud: forced failure for '$needle'" >&2
      exit 1
      ;;
  esac
fi

PROJECT_NUMBER=123456789012

case "$ARGS" in
  "projects describe "*)
    if state_file project-missing; then
      echo "fake gcloud: project not found" >&2
      exit 1
    fi
    echo "$PROJECT_NUMBER"
    ;;

  "billing projects describe "*)
    if state_file billing-disabled; then
      echo "False"
    else
      echo "True"
    fi
    ;;

  "services enable"*)
    exit 0
    ;;

  "artifacts repositories describe "*)
    state_file ar-repo-exists || { echo "fake gcloud: repo not found" >&2; exit 1; }
    ;;
  "artifacts repositories create "*)
    exit 0
    ;;
  "artifacts repositories set-cleanup-policies"*)
    exit 0
    ;;
  "artifacts docker images describe "*)
    state_file image-exists || { echo "fake gcloud: image not found" >&2; exit 1; }
    ;;

  "services vpc-peerings list"*)
    if state_file no-vpc-peering; then
      echo ""
    else
      echo "google-managed-services-default"
    fi
    ;;

  "sql instances describe "*"--format=value(state)"*)
    echo "RUNNABLE"
    ;;
  "sql instances describe "*"--format=value(connectionName)"*)
    echo "test-proj:asia-northeast3:$(printf '%s' "$ARGS" | grep -oE 'plant8-[a-z]+-db' | head -1)"
    ;;
  "sql instances describe "*)
    state_file sql-instance-exists || { echo "fake gcloud: sql instance not found" >&2; exit 1; }
    ;;
  "sql instances create "*|"beta sql instances create "*)
    exit 0
    ;;

  "sql databases describe "*)
    state_file db-exists || { echo "fake gcloud: db not found" >&2; exit 1; }
    ;;
  "sql databases create "*)
    exit 0
    ;;

  "sql users list"*)
    state_val iam-user-created
    ;;
  "sql users create "*)
    exit 0
    ;;
  "sql users set-password "*)
    exit 0
    ;;

  # 04.3-08: 시크릿 데이터는 상태 파일 secret-data-<이름>에 둔다(versions add가 쓰고
  # versions access가 읽는다). 데이터 파일이 있으면 ENABLED 버전 하나가 있는 것이고,
  # 없으면 예전처럼 공용 secret-version-exists를 따른다 — 단 감싼 시크릿(-wrapped-)은
  # 데이터 파일 유무만 따른다(공용 상태 하나로 감싼 v2가 있는 것처럼 보이지 않게).
  # 검토 반영 B1: secret-disabled-<이름>이면 버전은 있지만 ENABLED는 없다(끈 버전).
  "secrets versions list"*)
    secret="$(printf '%s\n' "$ARGS" | grep -oE -- '--secret=[^ ]+' | cut -d= -f2)"
    if state_file "secret-disabled-${secret}"; then
      case "$ARGS" in
        *"state:ENABLED"*) ;;
        *) echo "projects/test-proj/secrets/${secret}/versions/1" ;;
      esac
    elif state_file "secret-data-${secret}"; then
      echo "projects/test-proj/secrets/${secret}/versions/1"
    else
      case "$secret" in
        *-wrapped-*) ;;
        *) state_val secret-version-exists ;;
      esac
    fi
    ;;
  "secrets versions access latest "*)
    secret="$(printf '%s\n' "$ARGS" | grep -oE -- '--secret=[^ ]+' | cut -d= -f2)"
    state_file "secret-data-${secret}" || { echo "fake gcloud: secret version not found" >&2; exit 1; }
    cat "$STATE/secret-data-${secret}"
    ;;
  "secrets describe "*"--format=value(labels.kms-key-version)"*)
    state_val "secret-label-$3"
    ;;
  # 검토 반영 B1: 시크릿마다 존재를 본다(공용 secret-exists · 데이터 · 만든 기록 · 끈 버전).
  # 없으면 실제 gcloud처럼 NOT_FOUND를 말한다 — 배포는 그 말만 「없음」으로 읽는다.
  "secrets describe "*)
    state_file secret-exists || state_file "secret-data-$3" || state_file "secret-created-$3" ||
      state_file "secret-disabled-$3" ||
      { echo "ERROR: (gcloud.secrets.describe) NOT_FOUND: fake secret $3 not found" >&2; exit 1; }
    ;;
  "secrets create "*)
    [ -n "$STATE" ] && : >"$STATE/secret-created-$3"
    exit 0
    ;;
  "secrets update "*"--update-labels=kms-key-version="*)
    label="$(printf '%s\n' "$ARGS" | grep -oE -- '--update-labels=kms-key-version=[^ ]+' | cut -d= -f3)"
    [ -n "$STATE" ] && printf '%s' "$label" >"$STATE/secret-label-$3"
    exit 0
    ;;
  "secrets versions add"*)
    if [ -n "$STATE" ]; then
      cat >"$STATE/secret-data-$4"
    else
      cat >/dev/null
    fi
    exit 0
    ;;
  "secrets add-iam-policy-binding"*)
    exit 0
    ;;

  "auth configure-docker"*)
    exit 0
    ;;

  "run jobs deploy "*)
    exit 0
    ;;
  "run jobs execute "*"db-bootstrap"*)
    if state_file fail-db-bootstrap; then
      echo "fake gcloud: db-bootstrap job failed" >&2
      exit 1
    fi
    exit 0
    ;;
  "run jobs execute "*"migrate"*)
    if state_file fail-migrate; then
      echo "fake gcloud: migrate job failed" >&2
      exit 1
    fi
    exit 0
    ;;
  "run jobs execute "*"seed"*)
    if state_file fail-seed; then
      echo "fake gcloud: seed job failed" >&2
      exit 1
    fi
    exit 0
    ;;
  "run jobs execute "*)
    exit 0
    ;;

  "logging read "*)
    if state_file fail-migrate && [ "$(state_val fail-migrate)" = "3" ]; then
      echo '{"event":"deploy.pool_rule_violation"}'
    fi
    exit 0
    ;;

  "run deploy "*)
    exit 0
    ;;

  "run services describe "*"--format=value(status.url)"*)
    if state_file describe-url; then
      state_val describe-url
    else
      svc="$(printf '%s\n' "$ARGS" | awk '{print $4}')"
      region="$(printf '%s\n' "$ARGS" | grep -oE -- '--region=[^ ]+' | cut -d= -f2)"
      echo "https://${svc}-${PROJECT_NUMBER}.${region}.run.app"
    fi
    ;;
  "run services describe "*"--format=json"*)
    if ! state_file service-exists; then
      echo "fake gcloud: service not found" >&2
      exit 1
    fi
    url_field=""
    if state_file describe-url; then
      url_field="\"url\": \"$(state_val describe-url)\","
    fi
    serving=""
    if state_file serving; then
      serving="$(state_val serving)"
    fi
    traffic="[]"
    if [ -n "$serving" ]; then
      traffic="[{\"revisionName\":\"$serving\",\"percent\":100}]"
    fi
    echo "{ \"status\": { $url_field \"traffic\": $traffic } }"
    ;;
  "run services describe "*)
    state_file service-exists || { echo "fake gcloud: service not found" >&2; exit 1; }
    ;;

  "run services update-traffic "*)
    exit 0
    ;;
  "run services update "*)
    exit 0
    ;;
  "run services get-iam-policy "*)
    exit 0
    ;;

  "run revisions list"*)
    if state_file revisions; then
      state_val revisions
    fi
    ;;
  "run revisions describe "*"--format=json"*)
    # 리비전의 spec.containers[0] — 이미지 문자열과 환경변수. Cloud Run은 배포
    # 시점에 `app:<sha>` 태그를 다이제스트로 해석해 저장하므로(01-07 실측)
    # 기본 revision-image도 다이제스트 형태다. 진짜 배포 SHA는 APP_GIT_SHA.
    #
    # 리비전마다 다른 SHA가 필요한 경우(한 배포가 리비전을 둘 만드는 실제 동작)
    # 상태 파일 revision-git-sha-<리비전이름>을 먼저 본다. 없으면 공용
    # revision-git-sha로 떨어진다.
    # ARGS: run revisions describe <name> ... → 이름은 네 번째 인자다.
    rev_name="$4"
    image="$(state_val revision-image)"
    env_entries='{"name":"APP_ENV","value":"staging"}'
    rev_sha=""
    if state_file "revision-git-sha-${rev_name}"; then
      rev_sha="$(state_val "revision-git-sha-${rev_name}")"
    elif state_file revision-git-sha; then
      rev_sha="$(state_val revision-git-sha)"
    fi
    if [ -n "$rev_sha" ]; then
      env_entries="$env_entries,{\"name\":\"APP_GIT_SHA\",\"value\":\"$rev_sha\"}"
    fi
    echo "{\"spec\":{\"containers\":[{\"image\":\"$image\",\"env\":[$env_entries]}]}}"
    ;;
  "run revisions describe "*)
    exit 0
    ;;

  "beta monitoring channels list"*)
    state_val channel-name
    ;;
  "beta monitoring channels create"*)
    exit 0
    ;;

  "logging metrics describe "*)
    state_file metric-exists || { echo "fake gcloud: metric not found" >&2; exit 1; }
    ;;
  "logging metrics create "*)
    exit 0
    ;;

  "alpha monitoring policies list"*)
    if state_file policy-exists; then
      echo "projects/test-proj/alertPolicies/1"
    fi
    ;;
  "alpha monitoring policies create"*)
    exit 0
    ;;
  "alpha monitoring policies update"*)
    exit 0
    ;;

  "scheduler jobs describe "*)
    state_file scheduler-job || { echo "fake gcloud: scheduler job not found" >&2; exit 1; }
    ;;
  "scheduler jobs create http "*)
    exit 0
    ;;
  "scheduler jobs update http "*)
    exit 0
    ;;

  "beta run domain-mappings list"*)
    exit 0
    ;;

  "iam workload-identity-pools describe "*)
    state_file wif-pool-exists || { echo "fake gcloud: pool not found" >&2; exit 1; }
    ;;
  "iam workload-identity-pools create "*)
    exit 0
    ;;
  "iam workload-identity-pools providers describe "*)
    state_file wif-provider-exists || { echo "fake gcloud: provider not found" >&2; exit 1; }
    ;;
  "iam workload-identity-pools providers create-oidc "*)
    exit 0
    ;;

  "iam service-accounts describe "*)
    state_file sa-exists || { echo "fake gcloud: sa not found" >&2; exit 1; }
    ;;
  "iam service-accounts create "*)
    exit 0
    ;;
  "iam service-accounts add-iam-policy-binding"*)
    exit 0
    ;;

  "projects add-iam-policy-binding"*)
    exit 0
    ;;
  # 04.3-08(교차 B4): 호출됐다는 것만 로그로 남긴다 — IAM은 흉내 내지 않는다.
  "projects remove-iam-policy-binding"*)
    exit 0
    ;;

  # 04.3-08: KMS. 존재는 상태 파일(kms-keyring-exists · kms-key-exists), 주 버전은
  # kms-primary(없으면 1 — 소유자가 만든 새 주 버전을 테스트가 이 파일로 흉내 낸다).
  # encrypt는 표준 입력 앞에 FAKEKMS<주 버전>을 붙이고, decrypt는 그 머리를 확인하고
  # 뗀다(실제 KMS처럼 켜진 어느 버전의 암호문이든 푼다). 키 버전을 만드는 분기는
  # 두지 않는다 — 배포는 버전을 만들지 않는다(끝 분기에서 실패).
  "kms keyrings describe "*)
    state_file kms-keyring-exists || { echo "fake gcloud: keyring not found" >&2; exit 1; }
    ;;
  "kms keyrings create "*)
    exit 0
    ;;
  "kms keys describe "*"--format=value(primary.name)"*)
    primary="$(state_val kms-primary)"
    echo "projects/test-proj/locations/asia-northeast3/keyRings/r/cryptoKeys/app-data-key/cryptoKeyVersions/${primary:-1}"
    ;;
  "kms keys describe "*)
    state_file kms-key-exists || { echo "ERROR: (gcloud.kms.keys.describe) NOT_FOUND: fake key not found" >&2; exit 1; }
    ;;
  "kms keys create "*)
    exit 0
    ;;
  "kms keys add-iam-policy-binding "*)
    exit 0
    ;;
  "kms encrypt "*)
    primary="$(state_val kms-primary)"
    printf 'FAKEKMS%s' "${primary:-1}"
    cat
    ;;
  # 검토 반영 M1: kms-decrypt-plaintext가 있으면 그 내용을 평문으로 돌려준다(왕복 어긋남 흉내).
  "kms decrypt "*)
    data="$(cat)"
    if state_file kms-decrypt-plaintext; then
      state_val kms-decrypt-plaintext
      exit 0
    fi
    case "$data" in
      FAKEKMS[0-9]*) printf '%s' "${data:8}" ;;
      *) echo "fake gcloud: not a fake KMS ciphertext" >&2; exit 1 ;;
    esac
    ;;

  "compute networks describe "*)
    state_file network-exists || { echo "fake gcloud: network not found" >&2; exit 1; }
    ;;
  "compute networks create "*)
    exit 0
    ;;
  "compute addresses describe "*)
    state_file address-exists || { echo "fake gcloud: address not found" >&2; exit 1; }
    ;;
  "compute addresses create"*)
    exit 0
    ;;

  "services vpc-peerings connect"*)
    exit 0
    ;;

  "org-policies describe "*)
    if state_file org-policy-blocks-wif; then
      case "$ARGS" in
        *"iam.workloadIdentityPoolProviders"*)
          echo "constraint: constraints/iam.workloadIdentityPoolProviders"
          echo "listPolicy: { deniedValues: [\"*\"] }"
          exit 0
          ;;
      esac
    fi
    echo "constraint: (unset)"
    exit 0
    ;;

  "storage buckets describe "*)
    state_file bucket-exists || { echo "fake gcloud: bucket not found" >&2; exit 1; }
    ;;
  "storage buckets create "*)
    exit 0
    ;;
  "storage buckets update "*)
    exit 0
    ;;
  "storage buckets add-iam-policy-binding "*)
    exit 0
    ;;

  *)
    echo "fake gcloud: unhandled invocation: $ARGS" >&2
    exit 1
    ;;
esac
